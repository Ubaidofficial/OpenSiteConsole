# Google OAuth (Web application). Redirect URI: ${ORIGIN}/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Public origin of the app, used to build the OAuth redirect URI
ORIGIN=http://localhost:5173
# 32+ random chars; encrypts OAuth tokens at rest (openssl rand -base64 32)
APP_SECRET=
# Optional: protect the whole app with a single password
ADMIN_PASSWORD=
# Alternative to ADMIN_PASSWORD: a scrypt hash of the password, so the password itself is never stored (make one with: pnpm hash-password). Wins if both are set.
ADMIN_PASSWORD_HASH=
# Hosted plan only: the one OAuth redirect address shared by all customer instances (the control app's /oauth/callback). Leave empty for a normal install.
OAUTH_REDIRECT_URI=
# Set to 1 to run on synthetic data without Google credentials
DEMO_MODE=0
# URLs the optional per-site indexing monitor inspects per run (default 40, max 200). URL Inspection has a daily quota.
INDEX_MONITOR_URLS=40
# On-page checks refuse private addresses and non-standard ports. Set to 1 only if your site lives on your own network or a dev machine.
ONPAGE_ALLOW_PRIVATE=0
DB_PATH=./data/opensiteconsole.db

# Request GA4 read access in the same Google consent (default 1). Set 0 for Search Console only.
GOOGLE_INCLUDE_GA4=1
# Request read-only Tag Manager access in the same Google consent (default 1). Set 0 to skip it.
GOOGLE_INCLUDE_GTM=1
# Optional one-click Bing sign-in. Register an OAuth client in Bing Webmaster Tools → Settings → API Access → OAuth Client,
# with redirect URI ${ORIGIN}/auth/bing/callback. Without these, users paste a Bing API key instead.
BING_CLIENT_ID=
BING_CLIENT_SECRET=

# Weekly digest and urgent alerts: a webhook URL (https). Without it, digests are still made and shown on the Digest page; there is no email.
DIGEST_WEBHOOK_URL=
# slack (default) | discord | json
DIGEST_WEBHOOK_FORMAT=slack
# Weekday of the weekly digest, 0 = Sunday ... 6 = Saturday (default 1 = Monday)
DIGEST_DAY=1
# Live URL inspections one MCP API key may cause per day (default 100, max 2000). Google allows about 2,000 a day per property.
MCP_INSPECT_PER_KEY_DAY=100
# IndexNow endpoint (https) and the most URLs submitted per site per day (default 1000)
INDEXNOW_ENDPOINT=https://api.indexnow.org/indexnow
INDEXNOW_MAX_PER_DAY=1000
