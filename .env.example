# Google OAuth (Web application). Redirect URI: ${ORIGIN}/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Public origin of the app, used to build the OAuth redirect URI
ORIGIN=http://localhost:5173
# 32+ random chars; encrypts OAuth tokens at rest (openssl rand -base64 32)
APP_SECRET=
# "Sign in with Google" for SEOConsole itself (needs ADMIN_PASSWORD and the Google client above). Add a second redirect URI to the same OAuth client:
#   ${ORIGIN}/login/google/callback
# Only people already on the team can sign in this way. The owner is not a team member, so list the owner's Google address(es) here (comma separated):
OWNER_GOOGLE_EMAILS=
# Set to 0 to hide "Continue with Google" on the sign-in page.
GOOGLE_LOGIN=1
# Optional: protect the whole app with a single password
ADMIN_PASSWORD=
# Alternative to ADMIN_PASSWORD: a scrypt hash of the password, so the password itself is never stored (make one with: pnpm hash-password). Wins if both are set.
ADMIN_PASSWORD_HASH=
# Hosted plan only: the one OAuth redirect address shared by all customer instances (the control app's /oauth/callback). Leave empty for a normal install.
OAUTH_REDIRECT_URI=
# Set to 1 to run on synthetic data without Google credentials
DEMO_MODE=0
# URLs the optional per-site indexing monitor inspects per run (default 40, max 200). URL Inspection has a daily quota.
INDEX_MONITOR_URLS=40
# On-page checks refuse private addresses and non-standard ports. Set to 1 only if your site lives on your own network or a dev machine.
ONPAGE_ALLOW_PRIVATE=0
# Site logos on the dashboard are fetched by this server from each site's own host (no third-party favicon service). Set 0 to show letter avatars only.
# SITE_ICONS=1
DB_PATH=./data/opensiteconsole.db

# Request GA4 read access in the same Google consent (default 1). Set 0 for Search Console only.
GOOGLE_INCLUDE_GA4=1
# Request read-only Tag Manager access in the same Google consent (default 1). Set 0 to skip it.
GOOGLE_INCLUDE_GTM=1
# Optional one-click Bing sign-in. Register an OAuth client in Bing Webmaster Tools → Settings → API Access → OAuth Client,
# with redirect URI ${ORIGIN}/auth/bing/callback. Without these, users paste a Bing API key instead.
BING_CLIENT_ID=
BING_CLIENT_SECRET=

# Weekly digest and urgent alerts: a webhook URL (https). Without it, digests are still made and shown on the Digest page; there is no email.
DIGEST_WEBHOOK_URL=
# slack (default) | discord | json
DIGEST_WEBHOOK_FORMAT=slack
# Weekday of the weekly digest, 0 = Sunday ... 6 = Saturday (default 1 = Monday)
DIGEST_DAY=1
# 0 stops the automatic monthly report (made on the 4th for the previous month; still available by hand on the Digest page)
DIGEST_MONTHLY=1
# Extra callback addresses an MCP client may register for "Sign in" (comma-separated, exact, https). Claude's own is built in; leave empty otherwise.
MCP_OAUTH_REDIRECTS=
# Live URL inspections one MCP API key may cause per day (default 100, max 2000). Google allows about 2,000 a day per property.
MCP_INSPECT_PER_KEY_DAY=100
# IndexNow endpoint (https) and the most URLs submitted per site per day (default 1000)
INDEXNOW_ENDPOINT=https://api.indexnow.org/indexnow
INDEXNOW_MAX_PER_DAY=1000

# The privacy policy (/privacy) and terms (/terms) are public pages. Name yourself and a contact so they are complete; they are a starting
# point, not legal advice, so have them reviewed before relying on them (for example for Google's OAuth verification).
LEGAL_ENTITY=
LEGAL_CONTACT_EMAIL=
LEGAL_GOVERNING_LAW=

# AI answers (AI visibility tab): ask AI assistants your tracked prompts, with web search. Each key is optional; nothing runs
# without one. Every run is billed to your own account (tokens plus any per-search fee), so runs are capped per day.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
PERPLEXITY_API_KEY=
# Runs a day across all sites (default 60), and days between asking a prompt again (default 7)
AI_VIS_RUNS_PER_DAY=60
AI_VIS_EVERY_DAYS=7
# Or, instead of (or besides) the keys above: one DataForSEO login (app.dataforseo.com, API access). ChatGPT and Gemini are then
# read as seen in their apps for the location below; Claude and Perplexity go through DataForSEO when they have no key above.
# Billed per task by DataForSEO. AI_VIS_SOURCE: auto (default), direct (own keys only) or dataforseo (DataForSEO only).
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
AI_VIS_SOURCE=auto
# DataForSEO location and language codes for the apps (2840 = United States), and the country for API web search
AI_VIS_LOCATION_CODE=2840
AI_VIS_LANGUAGE_CODE=en
AI_VIS_COUNTRY=US
# DataForSEO model names (its /models endpoints list them; defaults claude-opus-5, sonar)
AI_VIS_DFS_CLAUDE_MODEL=
AI_VIS_DFS_PERPLEXITY_MODEL=
# Models (defaults: claude-opus-5-5 with effort medium, gpt-6-astra, sonar)
AI_VIS_CLAUDE_MODEL=
AI_VIS_CLAUDE_EFFORT=
AI_VIS_OPENAI_MODEL=
AI_VIS_PERPLEXITY_MODEL=

# Ask your data (the chat page): runs on Claude with ANTHROPIC_API_KEY above, billed to your Anthropic account.
# Model (default claude-opus-5-5), effort (low, medium, high, xhigh, max; default medium), messages per person per day (default 50).
CHAT_MODEL=
CHAT_EFFORT=
CHAT_MESSAGES_PER_DAY=50
